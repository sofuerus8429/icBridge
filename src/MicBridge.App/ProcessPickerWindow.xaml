<Window x:Class="MicBridge.App.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择进程声音源 · MicBridge" Width="740" Height="580" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="选择进程声音源" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="默认列出全部进程。选择播放器进程即可采集；音桥自身和系统空闲进程不可采集。"
                       Style="{StaticResource Hint}" Margin="0,8,0,14"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="搜索进程名、窗口标题或 PID" Style="{StaticResource Hint}" Margin="0,0,0,5"/>
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="#101B25" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"
                         Padding="9,7" MinHeight="36" VerticalContentAlignment="Center" AutomationProperties.Name="搜索进程"/>
            </StackPanel>
            <Button Grid.Column="1" Content="刷新进程" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom" Margin="10,0,0,0"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,10,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <CheckBox Content="仅显示有音频会话的进程" IsChecked="{Binding OnlyAudio}"/>
            <TextBlock Grid.Column="1" Text="PID" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,20,0"/>
        </Grid>
        <ListBox Grid.Row="3" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}"
                 MouseDoubleClick="OnProcessDoubleClick" AutomationProperties.Name="可采集的进程">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,4">
                        <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding CanCapture}" Value="False"><Setter Property="Opacity" Value="0.4"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SourceKind}" Foreground="{StaticResource Accent}" FontSize="11" Margin="12,1,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding WindowTitle}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding WindowTitle}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ProcessId}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="4" Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,8,0,10"/>
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Grid.Column="1" Content="取消" IsCancel="True" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="用作声音源" IsDefault="True" IsEnabled="{Binding CanAccept}"
                    Style="{StaticResource PrimaryButton}" Click="OnAccept"/>
        </Grid>
    </Grid>
</Window>
