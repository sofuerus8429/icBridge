<UserControl x:Class="MicBridge.App.Controls.ChannelStrip" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,6,0,0">
        <Grid Margin="0,0,0,3">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
            <ProgressBar Value="{Binding Meter, Mode=OneWay}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding Level}" Style="{StaticResource Hint}" TextAlignment="Right" FontSize="10" LineHeight="14"/>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="52"/><ColumnDefinition Width="22"/><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
            <TextBlock Text="音量" VerticalAlignment="Center" Style="{StaticResource Hint}"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="{Binding VolumeMaximum}" Value="{Binding Volume}" AutomationProperties.Name="通道音量"/>
            <TextBlock Grid.Column="2" Text="{Binding VolumeText}" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="增益" VerticalAlignment="Center" Style="{StaticResource Hint}"/>
            <Slider Grid.Column="5" Minimum="-24" Maximum="24" Value="{Binding Gain}" AutomationProperties.Name="通道增益"/>
            <TextBlock Grid.Column="6" Text="{Binding GainText}" TextAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
            <CheckBox Content="加入混音" IsChecked="{Binding Enabled}" Margin="0,4,22,4"/>
            <CheckBox Content="静音" IsChecked="{Binding Muted}"/>
            <CheckBox Content="GAIN · 最高 300%" IsChecked="{Binding GainMode}" Margin="22,4,0,4"/>
        </StackPanel>
    </StackPanel>
</UserControl>
